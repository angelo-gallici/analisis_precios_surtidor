# CSV reports
# *.csv  <-- DESCOMENTAR PARA SUBIR CSVs PEQUEÑOS DE SALIDA.
#             Si los CSVs descargados o procesados son grandes, usar las líneas de 'data/raw/' y 'data/processed/'
#             y NO esta línea genérica.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
